FROM python:3.11-slim

ENV POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_VIRTUALENVS_CREATE=true

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    wget \
    unzip \
    curl \
    gcc \
    libpq-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install OpenStack CLI (urllib3 floor: see Dockerfile)
RUN pip install --no-cache-dir python-openstackclient "urllib3>=2.8.0"

# Install Terraform
ARG TERRAFORM_VERSION=1.6.6
RUN wget https://releases.hashicorp.com/terraform/${TERRAFORM_VERSION}/terraform_${TERRAFORM_VERSION}_linux_amd64.zip \
    && unzip terraform_${TERRAFORM_VERSION}_linux_amd64.zip \
    && mv terraform /usr/local/bin/ \
    && rm terraform_${TERRAFORM_VERSION}_linux_amd64.zip

# Install Packer
ARG PACKER_VERSION=1.10.0
RUN wget https://releases.hashicorp.com/packer/${PACKER_VERSION}/packer_${PACKER_VERSION}_linux_amd64.zip \
    && unzip packer_${PACKER_VERSION}_linux_amd64.zip \
    && mv packer /usr/local/bin/ \
    && rm packer_${PACKER_VERSION}_linux_amd64.zip

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | python3 - && \
    ln -s /root/.local/bin/poetry /usr/local/bin/poetry

# Copy Poetry files and install dependencies
COPY pyproject.toml poetry.lock ./
RUN poetry install --no-root --no-interaction --no-ansi

# Copy application code
COPY . .

# Create temp directory for repositories (and the slot users' homes, if
# WORKER_JOB_UID_BASE is set)
RUN mkdir -p /tmp/worker_repos /var/lib/appstore-worker && \
    chmod 0711 /tmp/worker_repos /var/lib/appstore-worker

# Starte Celery Worker mit poetry run (fixed pool; no events, gossip or
# mingle: the Postgres transport has no fanout, .github#5)
CMD ["poetry", "run", "celery", "-A", "app.celery_app", "worker", "--loglevel=info", "--concurrency=2", "--without-gossip", "--without-mingle", "--without-heartbeat"]
