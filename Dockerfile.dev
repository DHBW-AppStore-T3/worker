FROM python:3.11-slim

ENV POETRY_VIRTUALENVS_IN_PROJECT=true \
    POETRY_VIRTUALENVS_CREATE=true

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libpq-dev \
    python3-pip \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry
RUN curl -sSL https://install.python-poetry.org | python3 - && \
    ln -s /root/.local/bin/poetry /usr/local/bin/poetry

# Copy Poetry files and install dependencies
COPY pyproject.toml poetry.lock ./
RUN poetry install --no-root --no-interaction --no-ansi

# Copy application code
COPY . .

# Starte Celery Worker mit poetry run (single process so in-memory FakeKube
# state is shared across deploy/pause/resume/destroy in WORKER_SIMULATE mode;
# consumes the pods queue; no events, gossip or mingle:
# the Postgres transport has no fanout, .github#5 / .github#6)
CMD ["poetry", "run", "celery", "-A", "app.celery_app", "worker", "--loglevel=info", "--pool=solo", "-Q", "pods", "--without-gossip", "--without-mingle", "--without-heartbeat"]
